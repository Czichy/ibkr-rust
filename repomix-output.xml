        exec_filter: Option<ExecutionFilter>,
    ) -> Result<()> {
        // let req_id = self.get_next_req_id();
        let frame = RequestExecutions::new(req_id, exec_filter);

        debug!(request = ?frame);

        // Write the frame to the socket
        self.writer.write_frame(&frame.into_frame()).await?;
        Ok(())
    }
}
