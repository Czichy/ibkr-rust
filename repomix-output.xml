pub(crate) fn notes_deserialize<'de, D>(
    deserializer: D,
) -> core::result::Result<Vec<Notes>, D::Error>
where
    D: Deserializer<'de>,
{
    let str_sequence = String::deserialize(deserializer)?;
    Ok(str_sequence
        .split(';')
        .map(Notes::from_str)
        .filter_map(|f| f.ok())
        //.flatten()
        .collect())
}

