    pub account_code:           Sender<String>,
    pub account_type:           Sender<String>,
    pub cash_balance:           Sender<D256>,
    pub equity_with_loan_value: Sender<D256>,
    pub excess_liquidity:       Sender<D256>,
    pub net_liquidation:        Sender<D256>,
