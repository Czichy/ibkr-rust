pub enum ShortAvailability {
    Available,
    HardToBorrow,
    Unavailable,
}

impl ShortAvailability {
    pub fn from_f64(val: f64) -> Self {
        if val > 2.5 {
            Self::Available
        } else if val > 1.5 {
            Self::HardToBorrow
        } else {
            Self::Unavailable
        }
    }
}
